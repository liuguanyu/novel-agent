{
  "name": "novel-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Human-in-the-loop 多智能体长篇小说创作 IDE",
  "type": "module",
  "author": "",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:persistence": "tsc -p tsconfig.smoke.json && node out-smoke/main/persistence-smoke.js",
    "smoke:orchestration": "tsc -p tsconfig.smoke.json && node out-smoke/main/orchestration-smoke.js",
    "smoke:extraction": "tsc -p tsconfig.smoke.json && node out-smoke/main/extraction-smoke.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@tiptap/core": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^3.0.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^9.15.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.1.4"
  }
}
